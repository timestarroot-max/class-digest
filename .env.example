# Пример файла настроек. Скопируйте в .env и подставьте свои значения.
# Токен бота можно получить в мессенджере MAX у @MasterBot.
MAX_BOT_TOKEN=ваш_токен_бота

# Ключ доступа к API GigaChat (Base64-строка ClientID:ClientSecret).
# Если оставить пустым — сводки строит встроенный локальный модуль.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель GigaChat (доступные для ключа: GigaChat-2-Max, GigaChat-2, GigaChat-2-Pro).
GIGACHAT_MODEL=GigaChat-2-Max

# Где хранить базу SQLite и на каком порту поднять веб-панель.
DATABASE_PATH=data/class_digest.db
WEB_PORT=8000
# Публичный адрес веб-панели: попадает в кнопку «Веб-панель учителя».
# MAX не принимает localhost в кнопках — указывайте IP или домен сервера.
PUBLIC_WEB_URL=http://localhost:8000

# Время автоматической сводки по умолчанию (ЧЧ:ММ).
DEFAULT_DIGEST_TIME=19:00
